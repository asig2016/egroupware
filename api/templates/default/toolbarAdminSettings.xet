<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
    <!-- no height="100%" here: in the dialog it resolved to the body's first, smaller height, so the
         list took all of it, the admin checkboxes lay outside and the body scrolled -->
    <et2-template  id="api.toolbarAdminSettings" template="" lang="" group="0" version="1.9.002">
        <et2-vbox>
            <et2-listbox  id="actions" multiple="true" label="show" helpText="show these toolbar items helptext"
            ></et2-listbox>
            <et2-vbox  hidden="!@isAdmin">
                <et2-checkbox  id="default" label="Set as default" statustext="Save as default preference for all users"></et2-checkbox>
                <et2-checkbox  id="reset" label="reset all to default" statustext="This will reset toolbar preferences for all users and set them to configured default prefs."></et2-checkbox>
            </et2-vbox>
        </et2-vbox>
        <et2-styles>
            /* a long list scrolls inside itself (this was #_actions, an id the list does not have) */
            #api-toolbarAdminSettings et2-listbox::part(form-control-input) {
            max-height: 25em;
            overflow-y: auto;
            }
            /* the help text is out of the flow for every widget (Et2Widget.styles.ts: a failed validation
               must not move the fields) - here it is a fixed text: on a line of its own under the list,
               out of the flow it lay over the admin checkboxes */
            #api-toolbarAdminSettings et2-listbox::part(form-control) {
            flex-wrap: wrap;
            }
            #api-toolbarAdminSettings et2-listbox::part(form-control-help-text) {
            position: static;
            flex-basis: 100%;
            margin-top: var(--sl-spacing-x-small);
            }
        </et2-styles>
    </et2-template>
</overlay>
